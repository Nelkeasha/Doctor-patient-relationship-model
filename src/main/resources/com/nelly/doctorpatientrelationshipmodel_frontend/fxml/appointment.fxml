<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<HBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.nelly.doctorpatientrelationshipmodel_frontend.controllers.AppointmentController"
      prefWidth="1280" prefHeight="820"
      style="-fx-background-color: #F1F5F9;">

    <!-- ═══ SIDEBAR (minimal) ═══ -->
    <VBox styleClass="sidebar" spacing="4">
        <HBox spacing="8" alignment="CENTER_LEFT" style="-fx-padding: 0 0 16 8;">
            <Label text="M" styleClass="nav-logo-icon"/>
            <Label text="Medicare" styleClass="sidebar-logo-text"/>
        </HBox>

        <VBox styleClass="sidebar-user-box">
            <StackPane style="-fx-background-color: #7C3AED; -fx-background-radius: 50; -fx-min-width: 42; -fx-min-height: 42; -fx-max-width: 42; -fx-max-height: 42; -fx-alignment: center;">
                <Label fx:id="sidebarInitials" text="PT"
                       style="-fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 16px;"/>
            </StackPane>
            <Label fx:id="sidebarName" text="Patient" styleClass="sidebar-user-name"/>
            <Label text="Patient" styleClass="sidebar-user-role"/>
        </VBox>

        <Label text="NAVIGATION" styleClass="sidebar-section-label"/>
        <Button text="← Back to Dashboard" styleClass="sidebar-btn"
                onAction="#goBack" maxWidth="Infinity"/>

        <Region VBox.vgrow="ALWAYS"/>
        <Button text="🚪  Logout" styleClass="sidebar-btn" onAction="#logout"
                maxWidth="Infinity" style="-fx-text-fill: #EF4444;"/>
    </VBox>

    <!-- ═══ MAIN CONTENT ═══ -->
    <ScrollPane HBox.hgrow="ALWAYS" fitToWidth="true" hbarPolicy="NEVER"
                style="-fx-background-color: #F1F5F9; -fx-border-color: transparent;">
        <VBox alignment="CENTER" style="-fx-padding: 50 80 50 80;" spacing="24">

            <!-- Page title -->
            <VBox spacing="6">
                <Label text="Book an Appointment" styleClass="dashboard-title"/>
                <Label text="Schedule your visit with your assigned doctor." styleClass="dashboard-subtitle"/>
            </VBox>

            <!-- Form card -->
            <VBox styleClass="appt-form-card" spacing="20" alignment="CENTER_LEFT" maxWidth="620">

                <!-- Doctor info (read-only) -->
                <VBox spacing="6">
                    <Label text="Your Doctor" styleClass="form-field-label"/>
                    <HBox spacing="14" alignment="CENTER_LEFT"
                          style="-fx-background-color: #F5F3FF; -fx-background-radius: 12; -fx-padding: 16;">
                        <StackPane fx:id="doctorAvatarBox"
                                   style="-fx-background-color: #7C3AED; -fx-background-radius: 50; -fx-min-width: 48; -fx-min-height: 48; -fx-max-width: 48; -fx-max-height: 48; -fx-alignment: center;">
                            <Label fx:id="doctorInitials" text="DR"
                                   style="-fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 16px;"/>
                        </StackPane>
                        <VBox spacing="3">
                            <Label fx:id="doctorNameLabel" text="No doctor assigned"
                                   style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #1F2937;"/>
                            <Label fx:id="doctorSpecLabel" text=""
                                   style="-fx-font-size: 13px; -fx-text-fill: #7C3AED;"/>
                        </VBox>
                    </HBox>
                </VBox>

                <!-- Date field -->
                <VBox spacing="6">
                    <Label text="Appointment Date" styleClass="form-field-label"/>
                    <DatePicker fx:id="datePicker" styleClass="combo-styled"
                                promptText="Select a date" maxWidth="Infinity"/>
                </VBox>

                <!-- Type / reason -->
                <VBox spacing="6">
                    <Label text="Appointment Type" styleClass="form-field-label"/>
                    <ComboBox fx:id="typeCombo" styleClass="combo-styled" maxWidth="Infinity"
                              promptText="Select appointment type"/>
                </VBox>

                <!-- Notes -->
                <VBox spacing="6">
                    <Label text="Notes / Reason for Visit" styleClass="form-field-label"/>
                    <TextArea fx:id="notesArea" promptText="Describe your symptoms or reason..."
                              styleClass="text-field-styled"
                              style="-fx-pref-height: 100; -fx-wrap-text: true;"
                              wrapText="true" maxWidth="Infinity"/>
                </VBox>

                <!-- Error -->
                <Label fx:id="errorLabel" text="" styleClass="form-error" wrapText="true"/>

                <!-- Buttons -->
                <HBox spacing="14" alignment="CENTER_LEFT" style="-fx-padding: 6 0 0 0;">
                    <Button text="Confirm Booking" styleClass="btn-primary"
                            onAction="#bookAppointment"
                            style="-fx-pref-height: 46; -fx-font-size: 15px; -fx-min-width: 180;"/>
                    <Button text="Cancel" styleClass="btn-secondary"
                            onAction="#goBack"
                            style="-fx-pref-height: 46;"/>
                </HBox>

            </VBox>

            <!-- Warning if no doctor assigned -->
            <VBox fx:id="noDoctorWarning" spacing="12" alignment="CENTER"
                  style="-fx-background-color: #FEF3C7; -fx-background-radius: 16; -fx-padding: 24; -fx-max-width: 620;">
                <Label text="⚠  No Doctor Assigned"
                       style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #92400E;"/>
                <Label text="You need an assigned doctor before you can book an appointment. Please contact the clinic to get a doctor assigned to your profile."
                       style="-fx-text-fill: #78350F; -fx-font-size: 14px; -fx-wrap-text: true; -fx-text-alignment: center;"
                       wrapText="true" maxWidth="500"/>
                <Button text="← Back to Dashboard" styleClass="btn-dark" onAction="#goBack"/>
            </VBox>

        </VBox>
    </ScrollPane>
</HBox>
